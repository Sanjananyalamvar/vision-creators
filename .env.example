DATABASE_URL=sqlite:///./recall.db
JWT_SECRET=change-me-to-a-long-random-string
# 32-byte urlsafe base64 key (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
VENDOR_SECRET_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TAX_RATE=0.08
VOLUME_DISCOUNT=0.15
AUTO_APPROVE_LIMIT=5000
PROVISIONING_SIMULATION=true
# --- Database options (pick one) ---
# SQLite (default):  DATABASE_URL=sqlite:///./recall.db     ->  python database/init_sqlite.py
# PostgreSQL:        DATABASE_URL=postgresql+psycopg://recall:recall@localhost:5432/recall   ->  docker compose up -d

# --- Query Mind / Hindsight (server-side only) ---
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=vision-mind
